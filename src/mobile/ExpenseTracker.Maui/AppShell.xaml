<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ExpenseTracker.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ExpenseTracker.Maui.Views"
    Title="Expense Tracker"
    FlyoutBehavior="Disabled"
    Shell.BackgroundColor="{StaticResource NavigationBackground}"
    Shell.ForegroundColor="{StaticResource NavigationForeground}"
    Shell.TitleColor="{StaticResource NavigationForeground}"
    Shell.DisabledColor="{StaticResource Gray300}"
    Shell.UnselectedColor="{StaticResource InfoBg}"
    Shell.TabBarBackgroundColor="{StaticResource Surface}"
    Shell.TabBarForegroundColor="{StaticResource Primary}"
    Shell.TabBarTitleColor="{StaticResource Primary}"
    Shell.TabBarUnselectedColor="{StaticResource TextSecondary}">

    <ShellContent
        x:Name="LoginShellContent"
        Title="Login"
        Route="LoginPage" />

    <ShellContent
        x:Name="EmployeeExpensesShellContent"
        Title="My expenses"
        Route="EmployeeExpensesPage" />

    <ShellContent
        x:Name="FinanceQueueShellContent"
        Title="Finance queue"
        Route="FinanceQueuePage" />

</Shell>
