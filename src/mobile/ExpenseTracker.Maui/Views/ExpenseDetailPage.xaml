<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ExpenseTracker.Maui.Views.ExpenseDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Expense detail">

    <ScrollView>
        <Grid x:Name="RootGrid" Padding="24" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="16">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <Label x:Name="CategoryLabel" Style="{StaticResource PageTitleLabel}" />
                <Border Grid.Column="1" Padding="8,4" BackgroundColor="{StaticResource InfoBg}" StrokeShape="RoundRectangle 10" Stroke="Transparent">
                    <Label x:Name="StatusLabel" FontSize="12" TextColor="{StaticResource Info}" FontAttributes="Bold" />
                </Border>
            </Grid>

            <!-- Amount + date -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                <Label x:Name="AmountLabel" Style="{StaticResource AmountLabel}" TextColor="{StaticResource Primary}" />
                <Label x:Name="DateLabel" Grid.Column="1" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
            </Grid>

            <!-- Description -->
            <VerticalStackLayout Grid.Row="2" Spacing="2">
                <Label Text="Description" Style="{StaticResource FieldLabel}" />
                <Label x:Name="DescriptionLabel" Style="{StaticResource BodyLabel}" />
            </VerticalStackLayout>

            <!-- Submitted at -->
            <VerticalStackLayout Grid.Row="3" Spacing="2" x:Name="SubmittedRow" IsVisible="False">
                <Label Text="Submitted at" Style="{StaticResource FieldLabel}" />
                <Label x:Name="SubmittedAtLabel" Style="{StaticResource BodyLabel}" />
            </VerticalStackLayout>

            <!-- Reviewed by + date -->
            <VerticalStackLayout Grid.Row="4" Spacing="2" x:Name="ReviewedRow" IsVisible="False">
                <Label Text="Reviewed by" Style="{StaticResource FieldLabel}" />
                <Label x:Name="ReviewedByLabel" Style="{StaticResource BodyLabel}" />
            </VerticalStackLayout>

            <!-- Rejection reason -->
            <Border Grid.Row="5" Style="{StaticResource DangerPanel}"
                    x:Name="RejectionRow" IsVisible="False">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Rejection reason" Style="{StaticResource FieldLabel}" TextColor="{StaticResource Danger}" />
                    <Label x:Name="RejectionReasonLabel" Style="{StaticResource ErrorLabel}" />
                </VerticalStackLayout>
            </Border>

            <!-- Receipt -->
            <VerticalStackLayout Grid.Row="6" Spacing="2" x:Name="ReceiptRow" IsVisible="False">
                <Label Text="Receipt" Style="{StaticResource FieldLabel}" />
                <Label x:Name="ReceiptLabel" Style="{StaticResource BodyLabel}" TextColor="{StaticResource Success}" />
            </VerticalStackLayout>

            <!-- Activity indicator -->
            <ActivityIndicator Grid.Row="7" x:Name="Busy" IsRunning="False" IsVisible="False" HorizontalOptions="Center" />

            <!-- Submit button -->
            <Button
                x:Name="SubmitButton"
                Grid.Row="8"
                Text="Submit for review"
                Clicked="OnSubmitClicked"
                Style="{StaticResource PrimaryButton}"
                IsVisible="False" />

            <!-- Upload receipt button -->
            <Button
                x:Name="UploadReceiptButton"
                Grid.Row="9"
                Text="Attach receipt (pre-signed URL)"
                Clicked="OnUploadReceiptClicked"
                Style="{StaticResource SuccessButton}"
                IsVisible="False" />

            <!-- Error -->
            <Label x:Name="ErrorLabel" Grid.Row="10" Style="{StaticResource ErrorLabel}" IsVisible="False" />

        </Grid>
    </ScrollView>

</ContentPage>
