<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ExpenseTracker.Maui.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Login">
    <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
        <Label
            Text="Expense Tracker"
            FontSize="28"
            FontAttributes="Bold" />
        <Label Text="Choose a mock profile to preview the MVP navigation." />
        <Button
            Text="Continue as Employee"
            Clicked="OnContinueAsEmployeeClicked" />
        <Button
            Text="Continue as Finance Manager"
            Clicked="OnContinueAsFinanceManagerClicked" />
    </VerticalStackLayout>
</ContentPage>
