<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ExpenseTracker.Maui.Views.CreateExpensePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="New expense">

    <ScrollView>
        <Grid Padding="24" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="14">

            <Label Text="New expense" Style="{StaticResource PageTitleLabel}" />

            <!-- Amount -->
            <VerticalStackLayout Grid.Row="1" Spacing="4">
                <Label Text="Amount" Style="{StaticResource FieldLabel}" />
                <Entry x:Name="AmountEntry" Placeholder="0.00" Keyboard="Numeric" />
            </VerticalStackLayout>

            <!-- Currency -->
            <VerticalStackLayout Grid.Row="2" Spacing="4">
                <Label Text="Currency" Style="{StaticResource FieldLabel}" />
                <Picker x:Name="CurrencyPicker" Title="Select currency">
                    <Picker.Items>
                        <x:String>EUR</x:String>
                        <x:String>USD</x:String>
                        <x:String>GBP</x:String>
                        <x:String>CHF</x:String>
                        <x:String>CAD</x:String>
                    </Picker.Items>
                </Picker>
            </VerticalStackLayout>

            <!-- Category -->
            <VerticalStackLayout Grid.Row="3" Spacing="4">
                <Label Text="Category" Style="{StaticResource FieldLabel}" />
                <Picker x:Name="CategoryPicker" Title="Select category">
                    <Picker.Items>
                        <x:String>Travel</x:String>
                        <x:String>Accommodation</x:String>
                        <x:String>Meals</x:String>
                        <x:String>Equipment</x:String>
                        <x:String>Training</x:String>
                        <x:String>Other</x:String>
                    </Picker.Items>
                </Picker>
            </VerticalStackLayout>

            <!-- Description -->
            <VerticalStackLayout Grid.Row="4" Spacing="4">
                <Label Text="Description" Style="{StaticResource FieldLabel}" />
                <Editor x:Name="DescriptionEditor" Placeholder="Brief description…" HeightRequest="80" />
            </VerticalStackLayout>

            <!-- Expense date -->
            <VerticalStackLayout Grid.Row="5" Spacing="4">
                <Label Text="Date" Style="{StaticResource FieldLabel}" />
                <DatePicker x:Name="ExpenseDatePicker" />
            </VerticalStackLayout>

            <!-- Error -->
            <Label x:Name="ErrorLabel" Grid.Row="6" Style="{StaticResource ErrorLabel}" IsVisible="False" />

            <!-- Submit -->
            <Button
                x:Name="CreateButton"
                Grid.Row="7"
                Text="Create expense"
                Clicked="OnCreateClicked"
                Style="{StaticResource PrimaryButton}" />

        </Grid>
    </ScrollView>

</ContentPage>
