<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ExpenseTracker.Maui.Views.EmployeeExpensesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="My expenses">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Sign out" Clicked="OnSignOutClicked" Order="Secondary" />
    </ContentPage.ToolbarItems>

    <Grid Padding="24" RowDefinitions="Auto,Auto,*" RowSpacing="16">

        <Grid ColumnDefinitions="*,Auto">
            <Label Text="My expenses" Style="{StaticResource PageTitleLabel}" VerticalOptions="Center" />
            <Button
                Grid.Column="1"
                Text="+"
                Style="{StaticResource IconButton}"
                Clicked="OnNewExpenseClicked" />
        </Grid>

        <ActivityIndicator
            x:Name="LoadingIndicator"
            Grid.Row="1"
            IsRunning="False"
            IsVisible="False"
            HorizontalOptions="Center" />

        <RefreshView x:Name="Refresher" Grid.Row="2" Refreshing="OnRefreshing">
            <CollectionView
                x:Name="ExpensesList"
                SelectionMode="Single"
                SelectionChanged="OnExpenseSelected">
                <CollectionView.EmptyView>
                    <Label
                        Text="No expenses yet — tap + to create your first one."
                        Style="{StaticResource MutedLabel}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                                <Label Text="{Binding Category}" Style="{StaticResource SectionTitleLabel}" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding StatusLabel}"
                                    TextColor="{Binding StatusColor}"
                                    FontSize="12"
                                    FontAttributes="Bold" />
                                <Label Grid.Row="1" Text="{Binding Description}" Grid.ColumnSpan="2" Style="{StaticResource MutedLabel}" />
                                <Label Grid.Row="2" Text="{Binding AmountDisplay}" Style="{StaticResource AmountLabel}" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding ExpenseDate}" Style="{StaticResource MutedLabel}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>
