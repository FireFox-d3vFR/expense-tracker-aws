<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ExpenseTracker.Maui.Views.FinanceQueuePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Finance queue">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Sign out" Clicked="OnSignOutClicked" Order="Secondary" />
    </ContentPage.ToolbarItems>

    <Grid Padding="24" RowDefinitions="Auto,Auto,*" RowSpacing="16">

        <Label Text="Finance queue" Style="{StaticResource PageTitleLabel}" />

        <ActivityIndicator
            x:Name="LoadingIndicator"
            Grid.Row="1"
            IsRunning="False"
            IsVisible="False"
            HorizontalOptions="Center" />

        <RefreshView x:Name="Refresher" Grid.Row="2" Refreshing="OnRefreshing">
            <CollectionView x:Name="QueueList">
                <CollectionView.EmptyView>
                    <Label
                        Text="All caught up — no pending expenses."
                        Style="{StaticResource MutedLabel}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                                <Label Text="{Binding Category}" Style="{StaticResource SectionTitleLabel}" />
                                <Label
                                    Grid.Column="1"
                                    Text="{Binding StatusLabel}"
                                    TextColor="{Binding StatusColor}"
                                    FontSize="12"
                                    FontAttributes="Bold" />
                                <Label Grid.Row="1" Text="{Binding Description}" Grid.ColumnSpan="2" Style="{StaticResource MutedLabel}" />
                                <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding AmountDisplay}" Style="{StaticResource AmountLabel}" />
                                    <Label Grid.Column="1" Text="{Binding EmployeeEmail}" Style="{StaticResource MutedLabel}" />
                                </Grid>
                                <HorizontalStackLayout Grid.Row="3" Grid.ColumnSpan="2" Spacing="12" Margin="0,6,0,0">
                                    <Button
                                        Text="Approve"
                                        Style="{StaticResource SuccessButton}"
                                        FontSize="12"
                                        Padding="12,6"
                                        CommandParameter="{Binding ExpenseId}"
                                        Clicked="OnApproveClicked" />
                                    <Button
                                        Text="Reject"
                                        Style="{StaticResource DangerButton}"
                                        FontSize="12"
                                        Padding="12,6"
                                        CommandParameter="{Binding ExpenseId}"
                                        Clicked="OnRejectClicked" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>
